# CAW node .env template (mainnet) — copy to client/.env and fill in.
# NEVER share a filled-in .env with anyone.

# Your PostgreSQL database (created by setup.sh; password is in /root/.caw-db-pass on your server)
DATABASE_URL=postgresql://caw:YOUR_DB_PASSWORD@127.0.0.1:5432/caw_mainnet

# Public RPC endpoints (free public ones work; your own are better)
L1_RPC_URL=wss://ethereum-rpc.publicnode.com
L1_RPC_URL_HTTP=https://ethereum-rpc.publicnode.com
L2_RPC_URL=wss://mainnet.base.org
L2_RPC_URL_HTTP=https://mainnet.base.org
ETH_MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com

# Validator only: YOUR wallet's private key, kept only on YOUR server.
# Leave empty for a read-only node.
VALIDATOR_PRIVATE_KEY=

SPONSOR_ENABLED=0
ZK_PROVER_ENABLED=0
L1_CHAIN_ID=1
COOKIE_SECURE=false
PRISMA_QUERY_ENGINE_TYPE=binary
MEDIA_STORAGE_BACKEND=local
NETWORK_ID=1
INSTANCE_API_URL=http://127.0.0.1:4000
